# Copy this template to .env.local, then fill in the sections you need.
# Keep real keys out of this file and Git. Restart npm run dev after env changes;
# rebuild/redeploy after changing NEXT_PUBLIC_ values in a deployed app.

# 1. REQUIRED: DYLI connection
# Create a Commerce key at https://www.dyli.io/requestapi (DYLI Pro required).
# The key discovers your application, login choice, branding, boxes and network.
# No application slug or DYLI infrastructure credentials are needed.
DYLI_API_KEY=

# 2. CHOOSE: live integration or non-paying demo
# false = real login and API transactions; production means real money/inventory.
# true = simulated purchases/openings, live catalog, no Privy setup required.
# Running on localhost does NOT make the live API a sandbox.
NEXT_PUBLIC_DEMO_MODE=false

# 3. LOGIN: follow the option you selected on the Commerce registration form.
# Skip this section in demo mode. The auth mode is discovered from your key;
# you do not need to set DYLI_AUTH_MODE.

# A. "Use your own Privy app": uncomment and fill in ALL THREE values below.
# Use a dedicated app for this storefront, not DYLI's main Privy app.
# Keep PRIVY_SECRET_KEY server-only. Register your app's origins in Privy.
# NEXT_PUBLIC_PRIVY_APP_ID=
# PRIVY_SECRET_KEY=
# STOREFRONT_ORIGIN=https://your-storefront.example
# Use the HTTPS domain registered with DYLI (no path or trailing slash).
# Checkout returns to the current page, including localhost/127.0.0.1 dev ports.
# Allow your local URL in Privy as well. Remote domains must be registered with
# DYLI; STOREFRONT_ORIGIN is a fallback, not an override of your current page.
# Localhost still uses REAL production payments unless separately configured.

# B. "Use your own login": leave the Privy fields commented out.
# Implement the client/server adapters in docs/EXISTING-AUTH.md using your own
# session verifier and Abstract-compatible wallets. Keep your provider's env
# settings in .env.local too. DYLI discovers the registered return origin.

# C. "Let DYLI manage login": no extra auth env values here.
# DYLI support must activate a dedicated app and approve your origins first.
# Managed-login provider credentials stay with DYLI, not in this starter.

# 4. OPTIONAL: API environment and URLs
# Production defaults below; leave commented for normal setup.
# DYLI_COMMERCE_BASE_URL=https://www.dyli.io/api/commerce/v1
# For a DYLI-provided lab, uncomment that setting and REPLACE its URL with the
# assigned lab URL. Also use its matching LAB key in DYLI_API_KEY.
# A local frontend or a URL change alone does not create an API sandbox.

# Optional doctor guard: fail the connection check against the wrong environment.
# Use production for production, or lab with a separately provisioned lab.
# This only affects npm run doctor; it does not block runtime transactions.
# DYLI_EXPECTED_ENVIRONMENT=production

# Advanced only: public Read API URL. Normally derived from the Commerce host,
# including for a lab. Leave commented unless DYLI supplies a separate endpoint;
# never read production data while sending writes to a lab.
# DYLI_READ_BASE_URL=https://www.dyli.io/api/public/v1

# 5. OPTIONAL: presentation overrides (otherwise use the registered app settings)
# NEXT_PUBLIC_STOREFRONT_NAME=My Store
# NEXT_PUBLIC_BOXES_ONLY=true
# This legacy setting only hides the older catalog. For a box-only app, disable
# marketplace/trading with the saved community settings below as well.
# SEO/social-image URL only; Vercel's production URL is used automatically there.
# This does not set or authorize a checkout return URL.
# NEXT_PUBLIC_SITE_URL=https://your-storefront.example

# OPTIONAL: limit this storefront to specific boxes (empty = all permitted boxes).
# Also enforced by this starter's quote route. DYLI's account allowlist still applies.
# INCLUDED_IDS=12997,12998

# OPTIONAL: add YOUR fee on top of each box. Choose ONE; leave both commented
# to inherit your app's DYLI fee rules (new apps default to no added fee).
# FLAT_FEE=2          # $2 per box; 3 boxes = $6, collected via Card or Balance.
# PERCENT_FEE=5       # 5% of the box subtotal; not 5% of profit.
# Set one to 0 for an explicitly zero-fee storefront. Keep these server-only.
# Your fee + the automatic 10% profit share appear in your DYLI Commerce tab
# and are claimable with normal earnings. No Stripe key or payout env needed.

# 6. OPTIONAL: wallet infrastructure
# OPTIONAL: marketplace and P2P discovery. These are server-only owner settings.
# Applied automatically by the server when the running storefront loads.
# Restart locally or redeploy after editing. Unset values keep saved settings.
# Use the same values everywhere that shares this key. No extra keys needed.
# Optional preview: npm run community:configure
# MARKETPLACE_ENABLED=true
# TRADING_ENABLED=true
# INCLUDE_DYLI_MARKETPLACE=false
# INCLUDE_DYLI_COLLECTORS=false
# Listings/offers created here always appear on DYLI. Inclusion controls which
# outside listings/collectors your storefront can discover, not privacy.

# Native Abstract paymaster settings are discovered from DYLI automatically.
# Want your own RPC? Create an Alchemy app with Abstract enabled, then paste YOUR
# app's API key below. The matching mainnet/testnet URL is built automatically.
# Leave unset to use Abstract's public RPC. This key is visible in the browser:
# restrict it to your storefront domains (and localhost for local development).
# Do not use an Alchemy admin/access key or a privileged server key here.
# NEXT_PUBLIC_ALCHEMY_API_KEY=
# Advanced: another provider's full browser RPC URL overrides the Alchemy key.
# It must support Abstract EIP-712 transactions and match DYLI's network.
# NEXT_PUBLIC_ABSTRACT_RPC_URL=
# Server balance reads use Abstract's public RPC by default, not the browser key.
# Optional server-only balance-read URL; it must match DYLI's network.
# DYLI_ABSTRACT_RPC_URL=

# 7. Storefront protection uses your DYLI key and DYLI's existing Supabase.
# No Redis or Supabase credentials go in this app. The connected API must support
# POST /storefront/limits; run npm run protection:check before deploying.
# Non-Vercel hosts only: set a header your trusted proxy OVERWRITES with one IP.
# Leave unset if unsure; unidentified clients share a rate-limit bucket.
# STOREFRONT_CLIENT_IP_HEADER=
# Setup, defaults and alerting: docs/ABUSE-CONTROLS.md

# 8. OPTIONAL: demo-only address autocomplete
# Not needed for live card checkout or live shipping; no Stripe secret required.
# Browser-visible keys: restrict their allowed origins/services in the provider.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Node 24+: npm ci, then npm run doctor (GET-only), then npm run dev.
# Open http://localhost:3000. Doctor checks live API readiness even in demo mode.
# Full setup and launch checks: docs/PARTNER-QUICKSTART.md
